{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DSH Desktop",
  "mainBinaryName": "dsh-desktop",
  "version": "0.1.0",
  "identifier": "com.dsh.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "DSH Desktop",
        "width": 1000,
        "height": 680,
        "minWidth": 800,
        "minHeight": 560
      }
      ,
      {
        "label": "launcher",
        "title": "DSH Launcher",
        "url": "index.html?window=launcher",
        "width": 640,
        "height": 420,
        "center": true,
        "alwaysOnTop": true,
        "decorations": false,
        "transparent": true,
        "skipTaskbar": true,
        "visible": false,
        "resizable": false,
        "shadow": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
      ,
      "windows": {
        "nsis": {
          "installMode": "currentUser",
          "languages": ["SimpChinese", "English"],
          "displayLanguageSelector": false
        }
      }
  }
}
